+import { cameraOf } from "../kit/iso-kit.mjs";
+import { add3, bandOf, dot3, lightOf, mul3, radialOf, sub3, tangentOf, unit3, viewOf } from "../kit/lathe.mjs";
+
+const TAU = Math.PI * 2;
+const wrap = (angle) => ((angle % TAU) + TAU) % TAU;
+
+function polygonsOf(d) {
+  return d.split("M").filter(Boolean).map((chunk) => {
+    const points = [...chunk.replace("Z", "").matchAll(/L?(-?[\d.]+) (-?[\d.]+)/g)].map((match) => [Number(match[1]), Number(match[2])]);
+    const xs = points.map(([x]) => x);
+    const ys = points.map(([, y]) => y);
+    return { points, box: [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)] };
+  });
+}
+
+function contains({ points, box }, x, y) {
+  if (x < box[0] || x > box[2] || y < box[1] || y > box[3]) return false;
+  let inside = false;
+  for (let i = 0, j = points.length - 1; i < points.length; j = i++) {
+    if (points[i][1] > y !== points[j][1] > y && x < ((points[j][0] - points[i][0]) * (y - points[i][1])) / (points[j][1] - points[i][1]) + points[i][0]) inside = !inside;
+  }
+  return inside;
+}
+
+function paintedTone(paths) {
+  const layers = [...paths.shades, paths.top].map(polygonsOf);
+  return (x, y) => layers.reduce((tone, polygons, band) => (polygons.some((polygon) => contains(polygon, x, y)) ? band : tone), -1);
+}
+
+function rayCaster(meridian, F, from, to, P) {
+  const part = to - from < TAU - 1e-9;
+  const V = viewOf(P);
+  const L = lightOf(P);
+  const { sinA, cosA, sinE, cosE, k } = cameraOf(P);
+  const across = [sinA, -cosA, 0];
+  const up = [cosA * sinE, sinA * sinE, -cosE];
+  const count = meridian.length;
+  const inPolygon = (s, r) => {
+    let inside = false;
+    for (let i = 0, j = count - 1; i < count; j = i++) {
+      const [si, ri] = meridian[i];
+      const [sj, rj] = meridian[j];
+      if (ri > r !== rj > r && s < ((sj - si) * (r - ri)) / (rj - ri) + si) inside = !inside;
+    }
+    return inside;
+  };
+  const local = (p) => {
+    const rel = sub3(p, F.o);
+    const u = dot3(rel, F.u);
+    const v = dot3(rel, F.v);
+    return [dot3(rel, F.a), Math.hypot(u, v), Math.atan2(v, u)];
+  };
+  const solid = (p) => {
+    const [s, r, angle] = local(p);
+    return (!part || wrap(angle - from) <= to - from) && inPolygon(s, r);
+  };
+  const edgeNormal = (i) => {
+    const [s0, r0] = meridian[i];
+    const [s1, r1] = meridian[(i + 1) % count];
+    const length = Math.hypot(s1 - s0, r1 - r0) || 1;
+    return [-(r1 - r0) / length, (s1 - s0) / length];
+  };
+  const vertexNormal = (i, own) => {
+    if (!meridian[i][2]) return own;
+    const a = edgeNormal((i + count - 1) % count);
+    const b = edgeNormal(i);
+    const length = Math.hypot(a[0] + b[0], a[1] + b[1]) || 1;
+    return [(a[0] + b[0]) / length, (a[1] + b[1]) / length];
+  };
+  const nearestEdge = (s, r) => {
+    let best = { distance: Infinity };
+    for (let i = 0; i < count; i++) {
+      const [s0, r0] = meridian[i];
+      const [s1, r1] = meridian[(i + 1) % count];
+      const ds = s1 - s0;
+      const dr = r1 - r0;
+      const t = Math.max(0, Math.min(1, ((s - s0) * ds + (r - r0) * dr) / (ds * ds + dr * dr || 1)));
+      const distance = Math.hypot(s - s0 - ds * t, r - r0 - dr * t);
+      if (distance < best.distance) best = { distance, i, t };
+    }
+    return best;
+  };
+  const surfaceNormal = (s, r, angle, { i, t }) => {
+    const own = edgeNormal(i);
+    const a = vertexNormal(i, own);
+    const b = vertexNormal((i + 1) % count, own);
+    const x = a[0] + (b[0] - a[0]) * t;
+    const y = a[1] + (b[1] - a[1]) * t;
+    const length = Math.hypot(x, y) || 1;
+    const out = inPolygon(s + (x / length) * 0.02, r + (y / length) * 0.02) ? -1 : 1;
+    return add3(mul3(F.a, (out * x) / length), mul3(radialOf(F, angle), (out * y) / length));
+  };
+  return (X, Y) => {
+    const dx = (X - P.origin[0]) / k;
+    const dy = (Y - P.origin[1]) / k;
+    const base = [0, 1, 2].map((axis) => across[axis] * dx + up[axis] * dy);
+    const at = (t) => [0, 1, 2].map((axis) => base[axis] + V[axis] * t);
+    let near = null;
+    for (let t = 160; t > -160; t--) {
+      if (solid(at(t))) {
+        near = t;
+        break;
+      }
+    }
+    if (near === null) return { hit: false };
+    let outside = near + 1;
+    let inside = near;
+    for (let i = 0; i < 14; i++) {
+      const mid = (outside + inside) / 2;
+      if (solid(at(mid))) inside = mid;
+      else outside = mid;
+    }
+    const [s, r, angle] = local(at(inside));
+    const edge = nearestEdge(s, r);
+    let normal = null;
+    let cutDistance = Infinity;
+    if (part) {
+      const gap = (turned) => (turned <= Math.PI / 2 ? r * Math.sin(turned) : r);
+      const intoPart = wrap(angle - from);
+      const fromGap = gap(intoPart);
+      const toGap = gap(to - from - intoPart);
+      cutDistance = Math.min(fromGap, toGap);
+      normal = fromGap < toGap ? mul3(tangentOf(F, from), -1) : tangentOf(F, to);
+    }
+    if (cutDistance >= edge.distance) normal = surfaceNormal(s, r, angle, edge);
+    return { hit: true, tone: bandOf(dot3(unit3(normal), L)) };
+  };
+}
+
+export function compareWithRayCast({ paths, meridian, F, from, to, P, width, height, step = 2 }) {
+  const paint = paintedTone(paths);
+  const cast = rayCaster(meridian, F, from, to, P);
+  const columns = Math.floor(width / step);
+  const rows = Math.floor(height / step);
+  const truth = [];
+  for (let j = 0; j < rows; j++) for (let i = 0; i < columns; i++) truth.push(cast(i * step, j * step));
+  const same = (a, b) => a.hit === b.hit && (!a.hit || a.tone === b.tone);
+  const cells = [];
+  let interior = 0;
+  let coverage = 0;
+  let tone = 0;
+  for (let j = 0; j < rows; j++) {
+    for (let i = 0; i < columns; i++) {
+      const here = truth[j * columns + i];
+      let edge = false;
+      for (let dj = -1; dj <= 1; dj++) {
+        for (let di = -1; di <= 1; di++) {
+          const other = truth[(j + dj) * columns + i + di];
+          if (j + dj >= 0 && j + dj < rows && i + di >= 0 && i + di < columns && !same(here, other)) edge = true;
+        }
+      }
+      if (edge) {
+        cells.push("edge");
+        continue;
+      }
+      interior++;
+      const painted = paint(i * step, j * step);
+      if (here.hit !== painted >= 0) {
+        coverage++;
+        cells.push("coverage");
+      } else if (here.hit && here.tone !== painted) {
+        tone++;
+        cells.push("tone");
+      } else cells.push(here.hit ? "match" : "empty");
+    }
+  }
+  return { interior, coverage, tone, columns, rows, cells };
+}
